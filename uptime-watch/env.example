# Copy to /etc/uptime-watch/env, owner root, mode 600. Never commit the real file.

# Telegram alerts: bot token from @BotFather and the chat id to send to
BOT_TOKEN=your-bot-token
CHAT_ID=your-chat-id

# Email alerts: off while SMTP_URL is empty. Gmail example:
# SMTP_URL=smtps://smtp.gmail.com:465, SMTP_USER=<mailbox>, SMTP_PASS=<app password>
MAIL_TO=
SMTP_URL=
SMTP_USER=
SMTP_PASS=

# Optional: label in alert text (default "uptime")
# LABEL=my-site
